# ==============================================================================
# ArchScale Frontend Environment Configuration
# Copy this file to frontend/.env and configure your backend endpoint.
# ==============================================================================

# Backend API Base URL
# IMPORTANT: In production, this must be set to the deployed backend's Vercel URL
# (e.g., https://your-backend-deployment.vercel.app/api).
# For local full-stack development against the local backend server, use:
# http://localhost:3000/api
VITE_API_URL=https://your-backend-deployment.vercel.app/api
