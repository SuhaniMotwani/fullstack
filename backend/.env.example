# ==============================================================================
# ArchScale Backend Environment Configuration
# Copy this file to backend/.env and populate with your actual secrets.
# Do NOT commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection String (PostgreSQL)
# ------------------------------------------------------------------------------
# Where to find in Supabase Dashboard:
# -> Project Settings -> Database -> Connection string -> URI
# NOTE: For serverless platforms like Vercel, use the "Transaction Pooler" mode
# (port 6543) rather than the direct connection (port 5432) to prevent exhausting
# connection limits. Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgres://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. Supabase Project URL
# ------------------------------------------------------------------------------
# Where to find in Supabase Dashboard:
# -> Project Settings -> API -> Project URL
# The base REST/Storage endpoint for your Supabase project instance.
SUPABASE_URL=https://[PROJECT_REF].supabase.co

# ------------------------------------------------------------------------------
# 3. Supabase Service Role Key (Admin / Storage Access)
# ------------------------------------------------------------------------------
# Where to find in Supabase Dashboard:
# -> Project Settings -> API -> Project API keys -> "service_role" (secret)
# IMPORTANT: This key bypasses Row Level Security (RLS) and is used exclusively
# by the backend server for platform document storage uploads and management.
# NEVER expose this key to client-side code or public repositories.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 4. JWT Secret Key
# ------------------------------------------------------------------------------
# Used by backend auth service to sign and verify tenant user authentication tokens.
# You can use a strong 32+ character random string, or use the Supabase JWT secret from:
# -> Project Settings -> API -> JWT Settings -> "JWT Secret"
JWT_SECRET=your-super-secret-jwt-signing-key-minimum-32-chars

# ------------------------------------------------------------------------------
# 5. CORS Allowed Origin (Frontend Deployment URL)
# ------------------------------------------------------------------------------
# Set to the production URL of your deployed frontend on Vercel.
# For local frontend development, use: http://localhost:3000
# Only requests originating from this URL will be permitted by the backend API.
CORS_ORIGIN=https://archscale-frontend.vercel.app
